# Tailscale File Uploader - Environment Configuration
# Copy this file to .env and change the secrets!

# Authentication password for the web uploader
UPLOAD_PASSWORD=change-this-password-now

# Secret key for signing Flask session cookies
SECRET_KEY=change-this-to-a-random-secret-key-32-chars-or-more

# Optional host and port overrides
HOST=0.0.0.0
PORT=5000

# Maximum request/file size limit in bytes (Default: 50 GB = 53687091200 bytes)
MAX_CONTENT_LENGTH=53687091200
